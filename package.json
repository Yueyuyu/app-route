{
  "name": "app-route",
  "version": "0.2.0-preview.1",
  "description": "AppRoute 应用分流：按应用选择联网方式，配合 Clash Party，提供独立恢复与试运行回退。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yueyuyu/app-route.git"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "npm run typecheck && npm run recovery:build && vite build",
    "check": "npm run test && npm run build",
    "check:i18n": "npm run build && node scripts/build-desktop.mjs --stage-only && node scripts/verify-localization.mjs",
    "check:recovery-faults": "npm run recovery:build && node scripts/verify-recovery-faults.mjs",
    "preview": "vite preview",
    "icons": "node scripts/prepare-icons.mjs",
    "icons:app": "powershell.exe -NoProfile -NonInteractive -File scripts/render-app-icon.ps1 && powershell.exe -NoProfile -NonInteractive -File scripts/export-app-icon.ps1",
    "recovery:build": "node scripts/build-recovery.mjs",
    "predev": "npm run recovery:build",
    "prepreview": "npm run recovery:build",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "desktop:install": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/install-desktop.ps1",
    "installer:build": "npm run desktop:build && node scripts/build-installer.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "antd": "6.7.0",
    "pngjs": "7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@iconify-json/icon-park": "1.2.4",
    "@iconify-json/logos": "1.2.19",
    "@iconify-json/simple-icons": "1.2.101",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "playwright": "1.65.0",
    "rolldown": "1.2.18",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
