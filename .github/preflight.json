{
  "version": 1,
  "required": [
    ".github/scripts/preflight.mjs",
    ".github/scripts/preflight.checks.mjs",
    ".githooks/pre-commit",
    ".githooks/pre-push",
    ".githooks/commit-msg",
    ".github/scripts/commit-evidence.mjs",
    "scripts/ci-scope.mjs",
    ".githooks/.gitattributes"
  ],
  "packageScripts": [
    "package.json"
  ],
  "checks": [
    ["node", "--test", ".github/scripts/commit-evidence.checks.mjs"],
    [
      "node",
      "--test",
      ".github/scripts/preflight.checks.mjs"
    ],
    [
      "node",
      "--test",
      "tests/ciScope.test.ts"
    ]
  ],
  "programChecks": [
    [
      "npm",
      "run",
      "check"
    ],
    [
      "npm",
      "run",
      "docs:check"
    ]
  ],
  "documentation": {
    "rootMarkdown": true,
    "files": [
      "LICENSE"
    ],
    "markdownDirectories": [
      "docs/"
    ],
    "runtimeDocuments": []
  },
  "generated": {},
  "excludedWorkflows": {}
}
